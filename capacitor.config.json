{
  "appId": "fr.finot.academie",
  "appName": "Finot Académie",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false,
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "style": "DEFAULT"
    }
  }
}
