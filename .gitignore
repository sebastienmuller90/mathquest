# Dépôt public : seul ce qui est nécessaire au fonctionnement de l'appli est publié.
# Liste blanche (tout est ignoré sauf ce qui est explicitement autorisé ci-dessous).
*
!/.gitignore
!/data/
!/data/**
!/js/
!/js/**
!/fonts/
!/fonts/**
!/index.html
!/parent.html
!/styles.css
!/pedagogy-upgrade.css
!/age-adaptive.css
!/premium-ui.css
!/premium-pro.css
!/premium-entry.css
!/premium-parent.css
# Outils de test épinglés pour une CI reproductible (pas d’étape de build).
!/package.json
!/package-lock.json
!/sw.js
!/manifest.webmanifest
!/icon.png
# Intégration continue : workflow et tests qu’elle exécute (exception validée le 21/10/2026).
# Le reste de tests/ (run-all, suites locales, rapports, captures) reste privé.
!/.github/
!/.github/workflows/
!/.github/workflows/mathquest-ci.yml
