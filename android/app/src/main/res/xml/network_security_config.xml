<?xml version="1.0" encoding="utf-8"?>
<!-- Finot Académie : HTTPS uniquement (l'app ne parle qu'au service de suivi parent, en HTTPS), autorités système seules. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
